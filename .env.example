# ─────────────────────────────────────────────────────────────────────────────
# AgriPulse AI — environment variables
# Server-side keys (no VITE_ prefix) are read by the Vercel Functions in /api.
# NEVER prefix a private key with VITE_ — Vite inlines those into the public bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Vision Agent cloud fallback  →  /api/predict
ULTRALYTICS_ENDPOINT_URL=https://platform.ultralytics.com/api/models/agrovision/agrovisionai/exp
ULTRALYTICS_API_KEY=
# Optional comma-separated extra origins; same-origin site requests are already allowed.
ALLOWED_ORIGINS=

# Weather  →  /api/weather  (https://www.weatherapi.com)
WEATHERAPI_KEY=

# Mandi prices  →  /api/mandi  (CEDA Agmarknet, https://api.ceda.ashoka.edu.in)
CEDA_API_KEY=
CEDA_API_BASE=https://api.ceda.ashoka.edu.in/v1/agmarknet

# SMS OTP  →  /api/otp  (real delivery to the farmer's phone)
# Pick ONE provider — with none configured, the login falls back to the
# on-screen demo OTP (no SMS is sent).
#  • Twilio (worldwide; trial accounts only text verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
#  • MSG91 (India; template must be approved in your MSG91/DLT dashboard)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
#  • Fast2SMS (India; dedicated OTP route — delivers to DND numbers too)
FAST2SMS_API_KEY=
# Optional explicit token-signing secret (defaults to your provider key)
OTP_SECRET=

# Google sign-in  →  /api/google  (real Google Identity Services)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Add the site origin under "Authorized JavaScript origins".
# This value is PUBLIC (it is embedded in the page) — no secret is needed.
GOOGLE_CLIENT_ID=

# Optional frontend-only settings (safe to expose)
VITE_MANDI_API_BASE=https://mandi-api.onrender.com/v1
