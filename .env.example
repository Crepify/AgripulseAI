# Weather API — indianapi.in (https://indianapi.in/weather-api)
# Get your free key: https://indianapi.in/sign-in
VITE_WEATHER_API_KEY=

# Mandi Price API — keyless, no key needed (https://mandi-api.vercel.app)
VITE_MANDI_API_BASE=https://mandi-api.onrender.com/v1

# --- Vision Agent cloud fallback (server-side only, used by api/predict.js; set in Vercel → Settings → Environment Variables) ---
# Shared Ultralytics Platform API of the AgriPulse model (free tier, 20 req/min per key):
ULTRALYTICS_ENDPOINT_URL=https://platform.ultralytics.com/api/models/agrovision/agrovisionai/exp
# Ultralytics Platform API key (Platform → Settings → API Keys). Never expose it in client code / VITE_ variables.
ULTRALYTICS_API_KEY=ul_xxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated origins allowed to call /api/predict (leave empty for preview deployments).
ALLOWED_ORIGINS=https://agripulse-ai-ten.vercel.app
