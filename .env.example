# ── WhatsApp Cloud API (direct Meta integration — Option A) ─────────────
# From Meta Developer Console → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging permission
WHATSAPP_API_TOKEN=
# Any secret string YOU choose; must match the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=
# Graph API version (default v20.0)
# WHATSAPP_GRAPH_VERSION=v20.0

# Standalone webhook server port (server/index.js only; Vercel ignores this)
PORT=8787

# Public URL of the deployed PWA (used in WhatsApp deep links)
PUBLIC_APP_URL=https://agripulse.ai

# ── Existing upstream keys (already used by api/) ───────────────────────
# WEATHERAPI_KEY=
# CEDA_API_KEY=
# SARVAM_API_KEY=
