# ── WhatsApp Cloud API (direct Meta integration — Option A) ─────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit a token.
# `npm run whatsapp:setup` verifies the token and auto-fills the two id vars.

# Permanent System User token with whatsapp_business_messaging
# (Business Settings → System Users). The API-Setup page token expires in 24h.
WHATSAPP_API_TOKEN=

# Meta phone-number id — NOT the phone number. Auto-discovered by:
#   npm run whatsapp:setup
# or copy it from Meta → your app → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Any secret string YOU choose; must match the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=

# Auto-filled by `npm run whatsapp:setup` (used for templates/status only)
# WHATSAPP_WABA_ID=
# WHATSAPP_BUSINESS_PHONE=

# Graph API version (default v20.0)
# WHATSAPP_GRAPH_VERSION=v20.0
# Test seam: point the client at a mock Graph server
# WHATSAPP_GRAPH_BASE=http://127.0.0.1:9000

# Guards POST /admin/send and /admin/broadcast on the standalone server.
# Defaults to WHATSAPP_VERIFY_TOKEN if unset.
# WHATSAPP_ADMIN_TOKEN=

# Standalone webhook server port (server/index.js only; Vercel ignores this)
PORT=8787

# Public URL of the deployed PWA (used in WhatsApp deep links)
PUBLIC_APP_URL=https://agripulse.ai

# ── Existing upstream keys (already used by api/) ───────────────────────
# WEATHERAPI_KEY=
# CEDA_API_KEY=
# SARVAM_API_KEY=
